    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "react-native": "^0.74.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.4.0"
  },
  "peerDependenciesMeta": {
