{
  "name": "@miniwall/react-native",
  "version": "0.1.0",
  "description": "Miniwall for React Native: show paywalls, onboarding and offers built in the Miniwall dashboard, rendered natively (iOS MiniwallSDK, Android app.miniwall:sdk).",
  "license": "MIT",
  "author": "Miniwall",
  "homepage": "https://docs.miniwall.app",
  "repository": { "type": "git", "url": "git+https://github.com/miniwall-app/miniwall-react-native.git" },
  "bugs": { "url": "https://github.com/miniwall-app/miniwall-react-native/issues" },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
